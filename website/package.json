{
  "name": "numpy-learning",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:generate && tsc && vite build",
    "preview": "vite preview",
    "content:generate": "python3 ../notes/notes-tracker.py",
    "content:check": "python3 ../notes/notes-tracker.py check",
    "content:normalize": "python3 ../notes/notes-tracker.py normalize",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "prismjs": "^1.29.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/prismjs": "^1.26.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
